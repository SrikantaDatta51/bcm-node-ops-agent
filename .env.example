# BCM Node Ops Agent — Environment Variables
# Copy to .env and fill in real values.

# ── Redfish BMC credentials ────────────────────────
REDFISH_USER=admin
REDFISH_PASSWORD=changeme
REDFISH_TLS_VERIFY=false
REDFISH_TIMEOUT=30

# ── Paths (inside container) ───────────────────────
NODE_INVENTORY_PATH=/opt/bcm-node-ops/config/nodes.yaml
AUDIT_LOG_DIR=/var/log/bcm-node-ops
