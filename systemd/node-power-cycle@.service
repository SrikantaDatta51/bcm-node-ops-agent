[Unit]
Description=Redfish Power Cycle for %i
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/opt/bcm-node-ops/.env
ExecStart=/opt/bcm-node-ops/scripts/redfish-power-cycle.sh %i
StandardOutput=journal
StandardError=journal
User=node-ops
Group=node-ops
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/bcm-node-ops
TimeoutStartSec=300
