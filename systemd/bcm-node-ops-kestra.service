[Unit]
Description=BCM Node Ops — Kestra Agent (containerd)
After=containerd.service bcm-node-ops-db.service
Requires=containerd.service
Wants=bcm-node-ops-db.service

[Service]
Type=simple
EnvironmentFile=/opt/bcm-node-ops/.env

ExecStartPre=-/usr/bin/ctr task kill bcm-node-ops-kestra
ExecStartPre=-/usr/bin/ctr container rm bcm-node-ops-kestra

ExecStart=/usr/bin/ctr run \
    --net-host \
    --env KESTRA_CONFIGURATION=/app/config/application.yaml \
    --mount type=bind,src=/opt/bcm-node-ops/scripts,dst=/opt/bcm-node-ops/scripts,options=rbind:ro \
    --mount type=bind,src=/opt/bcm-node-ops/config,dst=/opt/bcm-node-ops/config,options=rbind:ro \
    --mount type=bind,src=/opt/bcm-node-ops/config/kestra-application.yaml,dst=/app/config/application.yaml,options=rbind:ro \
    --mount type=bind,src=/var/log/bcm-node-ops,dst=/var/log/bcm-node-ops,options=rbind:rw \
    --mount type=bind,src=/var/lib/bcm-node-ops/kestra-data,dst=/app/storage,options=rbind:rw \
    docker.io/kestra/kestra:latest \
    bcm-node-ops-kestra \
    /bin/sh -c "kestra server standalone"

ExecStop=/usr/bin/ctr task kill bcm-node-ops-kestra

Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
