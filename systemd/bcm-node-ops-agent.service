[Unit]
Description=BCM Node Ops Agent (Kestra + Docker Compose)
After=docker.service
Requires=docker.service
Documentation=https://github.com/SrikantaDatta51/bcm-node-ops-agent

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/bcm-node-ops
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
