[Unit]
Description=BCM Node Status Check for %i
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/opt/bcm-node-ops/.env
ExecStart=/opt/bcm-node-ops/scripts/node-status.sh %i
StandardOutput=journal
StandardError=journal
User=node-ops
Group=node-ops
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/bcm-node-ops
TimeoutStartSec=60
