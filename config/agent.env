# Environment file for Go binary agent
# Used by: systemd/bcm-node-ops-agent-go.service
#
# Copy to /opt/bcm-node-ops/config/agent.env and fill in real values.

# ── SQS Queues ──────────────────────────────────────────────
SQS_REQUEST_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/fleet-node-ops-requests
SQS_RESPONSE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/fleet-node-ops-responses
AWS_REGION=us-east-1
SQS_WAIT_TIME=20
SQS_MAX_MESSAGES=1

# ── Redfish Credentials (per-vendor) ───────────────────────
# GPU nodes — NVIDIA DGX
REDFISH_USER_DGX=coupangdgx
REDFISH_PASSWORD_DGX=changeme-dgx

# CPU nodes — Dell iDRAC
REDFISH_USER_IDRAC=root
REDFISH_PASSWORD_IDRAC=changeme-idrac

# CPU nodes — HPE iLO
REDFISH_USER_ILO=pang
REDFISH_PASSWORD_ILO=changeme-ilo

# Global fallback
REDFISH_USER=admin
REDFISH_PASSWORD=changeme

REDFISH_TLS_VERIFY=false
REDFISH_TIMEOUT=30
